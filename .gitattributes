# 统一换行符策略，避免 Windows/macOS/Linux 协作时产生 CRLF/LF 噪声 diff。
* text=auto

*.rs    text eol=lf
*.toml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# 二进制资源：不做任何文本转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.webp  binary

# 许可原文按原字节保留，不进行换行转换。
LICENSE -text
LICENSE-ASSETS -text
LICENSES/** -text
