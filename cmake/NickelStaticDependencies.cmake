include_guard(GLOBAL)

# Windows release must link the real static zlib (zlibstatic.lib); an import library or a
# renamed DLL stub is a packaging error, not a warning to ignore.
function(nickel_require_windows_static_zlib target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Missing imported zlib target: ${target}")
    endif()
    get_target_property(_configurations "${target}" IMPORTED_CONFIGURATIONS)
    if(NOT _configurations)
        set(_configurations "")
    endif()
    list(APPEND _configurations RELEASE DEBUG RELWITHDEBINFO MINSIZEREL NOCONFIG
        ${CMAKE_CONFIGURATION_TYPES} ${CMAKE_BUILD_TYPE})
    list(REMOVE_DUPLICATES _configurations)
    set(_properties IMPORTED_LOCATION IMPORTED_IMPLIB)
    foreach(_configuration IN LISTS _configurations)
        string(TOUPPER "${_configuration}" _configuration)
        list(APPEND _properties "IMPORTED_LOCATION_${_configuration}" "IMPORTED_IMPLIB_${_configuration}")
    endforeach()
    set(_found_location FALSE)
    foreach(_property IN LISTS _properties)
        get_target_property(_location "${target}" "${_property}")
        if(NOT _location)
            continue()
        endif()
        if(_property MATCHES "^IMPORTED_IMPLIB")
            message(FATAL_ERROR "Windows release rejects a zlib DLL import library: ${_property}=${_location}")
        endif()
        get_filename_component(_name "${_location}" NAME)
        string(TOLOWER "${_name}" _name)
        if(NOT _name STREQUAL "zlibstatic.lib")
            message(FATAL_ERROR "Windows release requires actual zlibstatic.lib: ${_property}=${_location}")
        endif()
        if(NOT EXISTS "${_location}")
            message(FATAL_ERROR "Static zlib location does not exist: ${_location}")
        endif()
        set(_found_location TRUE)
    endforeach()
    if(NOT _found_location)
        message(FATAL_ERROR "The zlib target has no verifiable static imported location")
    endif()
endfunction()
