include_guard(GLOBAL)

# Domains come either from a read-only owner snapshot or from native/. The snapshot wins when
# present; a missing CMakeLists.txt is fatal instead of silently building an incomplete tree.
set(NICKEL_SHARED_NATIVE_ROOT "" CACHE PATH "Read-only owner snapshot native include root")
if(NOT NICKEL_SHARED_NATIVE_ROOT AND EXISTS "${CMAKE_SOURCE_DIR}/.snow/native-shared/snapshot.json")
    set(NICKEL_SHARED_NATIVE_ROOT "${CMAKE_SOURCE_DIR}/.snow/native-shared/native")
endif()
function(nickel_domain_path output relative)
    if(NICKEL_SHARED_NATIVE_ROOT)
        set(_source "${NICKEL_SHARED_NATIVE_ROOT}/${relative}")
    else()
        set(_source "${CMAKE_SOURCE_DIR}/native/${relative}")
    endif()
    if(NOT EXISTS "${_source}/CMakeLists.txt")
        message(FATAL_ERROR "Missing actual domain CMake: ${_source}/CMakeLists.txt; synchronize owner source before building")
    endif()
    set(${output} "${_source}" PARENT_SCOPE)
endfunction()
function(nickel_add_domain relative binary_name)
    nickel_domain_path(_source "${relative}")
    add_subdirectory("${_source}" "${CMAKE_BINARY_DIR}/domains/${binary_name}")
endfunction()
function(nickel_add_domain_tests relative binary_name)
    nickel_domain_path(_source "tests/${relative}")
    add_subdirectory("${_source}" "${CMAKE_BINARY_DIR}/tests/${binary_name}")
endfunction()
