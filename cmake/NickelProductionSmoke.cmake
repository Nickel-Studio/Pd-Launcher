# Optional frozen full-application consumer. It is deliberately exclusive: it cannot share a
# composite/portal source graph, and its harness root is bound separately by a manifest.
option(NICKEL_PRODUCTION_SMOKE_SAME_GRAPH "Include the frozen full-application smoke consumer in this production graph" OFF)
if(NICKEL_PRODUCTION_SMOKE_SAME_GRAPH)
    if(NOT NICKEL_BUILD_UI OR NOT NICKEL_BUILD_TESTS OR NOT TARGET Nickel::AppServices)
        message(FATAL_ERROR "Same-graph production smoke requires the complete application and root tests")
    endif()
    set(NICKEL_PRODUCTION_SMOKE_HARNESS_ROOT "${CMAKE_SOURCE_DIR}" CACHE PATH "Immutable acceptance source root, independently bound by the harness manifest")
    get_filename_component(_nickel_smoke_harness_root "${NICKEL_PRODUCTION_SMOKE_HARNESS_ROOT}" ABSOLUTE)
    set(_nickel_smoke_source "${_nickel_smoke_harness_root}/tests/native-production-smoke")
    if(NOT EXISTS "${_nickel_smoke_source}/CMakeLists.txt")
        message(FATAL_ERROR "Missing immutable full-application production-smoke consumer")
    endif()
    if(NICKEL_SHARED_NATIVE_ROOT OR NICKEL_PRODUCTION_SMOKE_LINK_PORTAL)
        message(FATAL_ERROR "Same-graph production smoke cannot use composite sources or historical link portals")
    endif()
    if(WIN32)
        set(_nickel_smoke_manifest "${CMAKE_BINARY_DIR}/native/app/windows.manifest")
        if(NOT EXISTS "${_nickel_smoke_manifest}")
            message(FATAL_ERROR "The same-graph application long-path manifest was not generated")
        endif()
        file(SHA256 "${_nickel_smoke_manifest}" _nickel_smoke_manifest_sha256)
        set(NICKEL_PRODUCTION_SMOKE_WINDOWS_MANIFEST "${_nickel_smoke_manifest}")
        set(NICKEL_PRODUCTION_SMOKE_WINDOWS_MANIFEST_SHA256 "${_nickel_smoke_manifest_sha256}")
    endif()
    add_subdirectory("${_nickel_smoke_source}" "${CMAKE_BINARY_DIR}/tests/production-smoke")
endif()
