{
  "schemaVersion": 1,
  "contract": "Palladium/Pd naming with unchanged Nickel schema-1 data",
  "baselineCommit": "07029c02974b6be904d9e7a5eb95eb11f3a73e2a",
  "historyPolicy": {
    "rootReadme": "README.md",
    "newProductReadme": "native/README.md",
    "nativeMetadata": "native/metadata.json",
    "preserve": "Legacy ZIPs, historical Nickel/Ni/NoWheRE sources and art, and frozen evidence are read-only. The root README documents the current Pd product; new Pd text belongs in the root README and native docs.",
    "staticCoverage": "Only root README content is pinned here with LF-normalized SHA-256. This tool does not inspect or accept legacy ZIPs or original user artwork."
  },
  "product": {
    "displayName": "Palladium",
    "shortName": "Pd",
    "chineseName": "\u94af",
    "recommendedExecutable": "pd-launcher",
    "dataNamespace": "studio.nickel.launcher"
  },
  "rules": [
