# Import only the production bytes and dependency recipe bound by the supplied portal.
foreach(_name NICKEL_PRODUCTION_SMOKE_LINK_PORTAL NICKEL_PRODUCTION_SMOKE_PORTAL_SHA256
        NICKEL_PRODUCTION_SMOKE_LINK_INPUTS NICKEL_PRODUCTION_SMOKE_LINK_INPUTS_SHA256)
    if(NOT DEFINED ${_name} OR "${${_name}}" STREQUAL "")
        message(FATAL_ERROR "${_name} is required for the matched production import")
    endif()
endforeach()
file(SHA256 "${NICKEL_PRODUCTION_SMOKE_LINK_PORTAL}" _portal_sha)
file(SHA256 "${NICKEL_PRODUCTION_SMOKE_LINK_INPUTS}" _inputs_sha)
if(NOT _portal_sha STREQUAL NICKEL_PRODUCTION_SMOKE_PORTAL_SHA256 OR
        NOT _inputs_sha STREQUAL NICKEL_PRODUCTION_SMOKE_LINK_INPUTS_SHA256)
    message(FATAL_ERROR "The raw portal or received link recipe no longer matches its explicit pin")
endif()
file(READ "${NICKEL_PRODUCTION_SMOKE_LINK_PORTAL}" _portal)
file(READ "${NICKEL_PRODUCTION_SMOKE_LINK_INPUTS}" _inputs)
string(JSON _generation GET "${_portal}" sourceGenerationManifestSha256)
string(JSON _input_generation GET "${_inputs}" sourceGenerationManifestSha256)
if(NOT _generation STREQUAL NICKEL_PRODUCTION_SMOKE_SOURCE_SHA256 OR
        NOT _input_generation STREQUAL _generation)
    message(FATAL_ERROR "The production libraries, received recipe and compiled source generation differ")
endif()
get_filename_component(_portal_root "${NICKEL_PRODUCTION_SMOKE_LINK_PORTAL}" DIRECTORY)
get_filename_component(_inputs_root "${NICKEL_PRODUCTION_SMOKE_LINK_INPUTS}" DIRECTORY)
string(JSON _prefix GET "${_portal}" toolchainCachePins CMAKE_PREFIX_PATH)
string(JSON _compiler GET "${_portal}" toolchainCachePins CMAKE_CXX_COMPILER)
file(REAL_PATH "${CMAKE_CXX_COMPILER}" _actual_compiler)
file(REAL_PATH "${_compiler}" _expected_compiler)
if(NOT _actual_compiler STREQUAL _expected_compiler OR NOT MSVC OR
        NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded")
    message(FATAL_ERROR "This old-generation portal requires its exact MSVC compiler and /MT runtime")
endif()
find_package(Qt6 6.8.3 EXACT CONFIG REQUIRED COMPONENTS Core Gui Widgets Svg
    PATHS "${_prefix}/lib/cmake/Qt6" NO_DEFAULT_PATH)

string(JSON _header_count LENGTH "${_portal}" files)
math(EXPR _last_header "${_header_count} - 1")
foreach(_index RANGE 0 ${_last_header})
    string(JSON _relative MEMBER "${_portal}" files ${_index})
    string(JSON _expected GET "${_portal}" files "${_relative}" sha256)
    file(SHA256 "${_portal_root}/${_relative}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Frozen production header changed: ${_relative}")
    endif()
endforeach()
string(JSON _received_count LENGTH "${_inputs}" files)
math(EXPR _last_received "${_received_count} - 1")
foreach(_index RANGE 0 ${_last_received})
    string(JSON _relative GET "${_inputs}" files ${_index} path)
    string(JSON _expected GET "${_inputs}" files ${_index} sha256)
    file(SHA256 "${_inputs_root}/${_relative}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Received old-generation input changed: ${_relative}")
    endif()
endforeach()

string(JSON _artifact_count LENGTH "${_portal}" artifacts)
math(EXPR _last_artifact "${_artifact_count} - 1")
foreach(_index RANGE 0 ${_last_artifact})
    string(JSON _location GET "${_portal}" artifacts ${_index} physicalPath)
    if(NOT _location MATCHES "[.]lib$")
        continue()
    endif()
    string(JSON _expected GET "${_portal}" artifacts ${_index} sha256)
    file(SHA256 "${_location}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Matched production library changed after relocation: ${_location}")
    endif()
    get_filename_component(_target "${_location}" NAME_WE)
    add_library("${_target}" STATIC IMPORTED GLOBAL)
    set_target_properties("${_target}" PROPERTIES IMPORTED_LOCATION "${_location}")
endforeach()
if(NOT TARGET nickel_app_services)
    message(FATAL_ERROR "The portal contains no real built AppServices library")
endif()
add_library(Nickel::AppServices ALIAS nickel_app_services)
set_target_properties(nickel_app_services PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_portal_root}/native;${_inputs_root}/native;${_prefix}/include"
    INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${_prefix}/include"
    INTERFACE_COMPILE_DEFINITIONS "CURL_STATICLIB;NICKEL_MINECRAFT_NATIVE_SERVICES=1;NOMINMAX;WIN32_LEAN_AND_MEAN;UNICODE;_UNICODE;_WIN32_WINNT=0x0A00"
)
# Qt supplies its actual resource objects and plugins; retain all non-Qt dependencies
# from the pinned production link line, including repeated native domain edges.
string(JSON _link_text GET "${_inputs}" historicalLinkAttributes LINK_LIBRARIES)
string(REGEX MATCHALL "[^ \t\r\n]+" _link_tokens "${_link_text}")
set(_link_dependencies Qt6::Core Qt6::Gui Qt6::Widgets Qt6::Svg)
foreach(_token IN LISTS _link_tokens)
    file(TO_CMAKE_PATH "${_token}" _location)
    if(_location MATCHES "[.]obj$" OR _location MATCHES "/plugins/" OR
            _location MATCHES "/Qt6[^/]*[.]lib$")
        continue()
    endif()
    get_filename_component(_target "${_location}" NAME_WE)
    if(TARGET "${_target}")
        if(NOT _target STREQUAL "nickel_app_services")
            list(APPEND _link_dependencies "${_target}")
        endif()
    elseif(IS_ABSOLUTE "${_location}")
        if(NOT EXISTS "${_location}")
            message(FATAL_ERROR "A bound production dependency is missing: ${_location}")
        endif()
        list(APPEND _link_dependencies "${_location}")
    elseif(NOT _location MATCHES "/" AND _location MATCHES "[.]lib$")
        list(APPEND _link_dependencies "${_location}")
    else()
        message(FATAL_ERROR "Unresolved dependency in the frozen production link recipe: ${_location}")
    endif()
endforeach()
set_target_properties(nickel_app_services PROPERTIES INTERFACE_LINK_LIBRARIES "${_link_dependencies}")
