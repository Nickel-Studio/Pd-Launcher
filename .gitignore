# ==============================================================================
# Palladium Launcher — 版本控制忽略规则
#
# 原则：只忽略「生成物 / 本地环境 / 私有材料 / 运行证据」。
#       源码、美术素材、许可证、面向人的文档必须入库。
# ==============================================================================

# ------------------------------------------------------------------------------
# 原生构建（CMake / Ninja / MSVC / GCC / Clang）
# 构建统一落在 build 树内；源码树中不得出现 CMake 生成物。
# ------------------------------------------------------------------------------
/build/
/cmake-build-*/
**/.build*/
**/build-*/
CMakeUserPresets.json
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
**/compile_commands.json
**/install_manifest.txt
**/Testing/
**/*_autogen/
**/mocs_compilation.cpp
**/moc_*.cpp
**/qrc_*.cpp
**/*.rsp
**/*.tlog

# 编译/链接产物（工程内无同名源码文件）
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.obj
*.o
*.a
*.lib
*.so
*.dylib

# ------------------------------------------------------------------------------
# Rust / Cargo（构建产物；Cargo.lock 需要入库，不在此忽略）
# ------------------------------------------------------------------------------
**/target/

# ------------------------------------------------------------------------------
# Node / pnpm（主页站点与前端工具链）
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo
.pnpm-store/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
_site/

# ------------------------------------------------------------------------------
# Python（CI/测试/构建脚本）
# ------------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# 日志、临时文件、编辑器备份
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.bak
*.orig
*.rej
*~
*.swp
*.swo

# ------------------------------------------------------------------------------
# 操作系统与 IDE 本地文件
# ------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
.vs/
.vscode/
!.vscode/extensions.json
.idea/
*.user
*.suo
*.sw?

# ------------------------------------------------------------------------------
# 本地凭据 / 私有配置（示例文件入库）
# ------------------------------------------------------------------------------
secrets.local.json
*.local
.env
.env.*
!.env.example
credentials.key
accounts.json
active_account.json
.minecraft/

# ------------------------------------------------------------------------------
# Agent / 工作区私有材料（含 team worktree 与本地临时区）
# .snow/ 整体不入库：其中仅含工作树、本地临时区与 CI 私有材料。
# ------------------------------------------------------------------------------
.snow/
.agents/
.claude/
.codex/
.cursor/
.session-export/
.worktrees/
.verify/
.verify_home.py
.playwright-mcp/
design/

# ------------------------------------------------------------------------------
# 测试运行证据 / 一次性质检产物
# 这些目录由测试脚本在运行时生成，属于证据输出，不入库。
# ------------------------------------------------------------------------------
**/evidence/
!tests/native-portability/evidence/
!tests/native-portability/evidence/linux-openssl-stable-metadata1527.json
!tests/native-portability/evidence/linux-openssl-official-checksum1529.json
**/backend-evidence/
tests/native-capacity-pathfinder/runs/

# ------------------------------------------------------------------------------
# AI / 人工会话过程留档（不属于产品源码或文档，禁止入库）
# ------------------------------------------------------------------------------
**/tool-test-evidence*.txt
**/visual-evidence*.json
**/source-check-evidence*.json
**/source-pixel-check-evidence*.json

# ------------------------------------------------------------------------------
# CI / 交付产物（本地下载与打包输出）
# ------------------------------------------------------------------------------
/artifacts/
/out/
/publish/
/evidence-*/

# ------------------------------------------------------------------------------
# 参考工程与一次性审计目录（不属于本项目源码）
# ------------------------------------------------------------------------------
HNLLauncher/
tests/task-audit/