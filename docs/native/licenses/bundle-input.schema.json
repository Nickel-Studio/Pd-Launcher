{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nickel-Studio/Ni-Launcher/docs/native/licenses/bundle-input.schema.json",
  "title": "Nickel actual native legal material input, not a release template",
  "type": "object",
  "required": ["schemaVersion", "scope", "releaseId", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": {
      "enum": ["asset-only", "native-dependency-snapshot", "native-release"]
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "build": { "$ref": "#/$defs/build" },
    "relink": { "$ref": "#/$defs/relink" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "native-release" } } },
      "then": { "required": ["build"] }
    }
  ],
  "$defs": {
    "material": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Exact checkout-relative path, no symlink, absolute path or traversal"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "kind": { "type": "string" },
        "componentId": { "type": "string" },
        "licenseId": {
          "type": "string",
          "pattern": "^LicenseRef-[A-Za-z0-9.+-]+$"
        },
        "commandPath": {
          "type": "string",
          "minLength": 1,
          "description": "Exact path consumed by the recorded relink command; provenance only, never followed outside the bundle"
        }
      }
    },
    "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "category",
        "linkage",
        "licenseConcluded",
        "copyrightText",
        "origin",
        "artifacts",
        "licenseFiles",
        "noticePolicy",
        "versionEvidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "application",
            "qt",
            "http",
            "archive",
            "crypto",
            "compression",
            "font",
            "artwork",
            "build-tool",
            "other"
          ]
        },
        "linkage": {
          "enum": [
            "static",
            "dynamic",
            "embedded",
            "source-only",
            "system",
            "build-only"
          ]
        },
        "redistributed": { "type": "boolean" },
        "licenseConcluded": {
          "type": "string",
          "minLength": 1,
          "description": "Actual selected SPDX expression, never NONE/NOASSERTION"
        },
        "licenseDeclared": { "type": "string", "minLength": 1 },
        "copyrightText": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 },
        "artifacts": { "$ref": "#/$defs/materials" },
        "licenseFiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/material" }
        },
        "noticeFiles": { "$ref": "#/$defs/materials" },
        "licenseRefTexts": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/material" },
              { "required": ["licenseId"] }
            ]
          }
        },
        "noticePolicy": {
          "enum": [
            "copyright-in-license",
            "copyright-in-notice",
            "upstream-notice-conveyed"
          ]
        },
        "versionEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/material" }
        },
        "correspondingSource": { "$ref": "#/$defs/materials" },
        "sourceDescription": { "type": "string" },
        "buildMaterials": { "$ref": "#/$defs/materials" },
        "qtModules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "qtThirdPartyCoverage": { "$ref": "#/$defs/materials" }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "platform",
        "architecture",
        "compiler",
        "compilerVersion",
        "executable",
        "evidence"
      ],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "compilerVersion": { "type": "string", "minLength": 1 },
        "executable": { "$ref": "#/$defs/material" },
        "evidence": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/material" }
        }
      }
    },
    "relink": {
      "type": "object",
      "required": [
        "applicationCode",
        "linkCommands",
        "buildInstructions",
        "installationInformation",
        "resources",
        "probe"
      ],
      "properties": {
        "applicationCode": { "$ref": "#/$defs/materials" },
        "linkCommands": { "$ref": "#/$defs/materials" },
        "buildInstructions": { "$ref": "#/$defs/materials" },
        "installationInformation": { "$ref": "#/$defs/materials" },
        "resources": { "$ref": "#/$defs/materials" },
        "probe": {
          "type": "object",
          "required": ["relinkedExecutable", "log", "replacementLibraries"],
          "properties": {
            "relinkedExecutable": { "$ref": "#/$defs/material" },
            "log": { "$ref": "#/$defs/material" },
            "replacementLibraries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/material" },
                  { "required": ["componentId", "commandPath"] }
                ]
              }
            },
            "responseFiles": {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/material" },
                  { "required": ["commandPath"] }
                ]
              }
            }
          }
        }
      }
    }
  }
}
