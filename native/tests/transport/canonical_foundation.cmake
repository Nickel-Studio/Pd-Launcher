if(TARGET nickel_foundation)
    return()
endif()
set(NICKEL_TRANSPORT_FOUNDATION_ROOT "" CACHE PATH "Read-only canonical Foundation native source root")
if(NOT NICKEL_TRANSPORT_FOUNDATION_ROOT)
    message(FATAL_ERROR "Set NICKEL_TRANSPORT_FOUNDATION_ROOT to the frozen canonical Foundation native root")
endif()
set(_nickel_guard_sources)
foreach(_source path_guard.cpp detail.cpp atomic_file.cpp crypto.cpp)
    set(_path "${NICKEL_TRANSPORT_FOUNDATION_ROOT}/core/config/${_source}")
    if(NOT EXISTS "${_path}")
        message(FATAL_ERROR "Canonical Foundation source is missing: ${_path}")
    endif()
    list(APPEND _nickel_guard_sources "${_path}")
endforeach()
find_package(nlohmann_json CONFIG REQUIRED)
# Standalone tests use unchanged canonical sources, not a substitute OS implementation.
add_library(nickel_transport_foundation_fixture STATIC ${_nickel_guard_sources})
add_library(nickel_foundation ALIAS nickel_transport_foundation_fixture)
target_include_directories(nickel_transport_foundation_fixture PUBLIC "${NICKEL_TRANSPORT_FOUNDATION_ROOT}")
target_compile_features(nickel_transport_foundation_fixture PUBLIC cxx_std_20)
target_link_libraries(nickel_transport_foundation_fixture PUBLIC nlohmann_json::nlohmann_json PRIVATE bcrypt advapi32)
target_compile_definitions(nickel_transport_foundation_fixture PRIVATE UNICODE _UNICODE)
if(MSVC)
    target_compile_options(nickel_transport_foundation_fixture PRIVATE /W4 /WX /permissive- /utf-8 /EHsc)
    set_property(TARGET nickel_transport_foundation_fixture PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
endif()
